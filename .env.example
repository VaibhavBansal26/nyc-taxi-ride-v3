# Copy to .env (never commit .env). Leave HOPSWORKS_API_KEY empty to run the app in demo mode.
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=
# Only for self-hosted clusters; leave empty for app.hopsworks.ai / serverless
HOPSWORKS_HOST=
# auto | live | demo
APP_MODE=auto
# Optional - only used by the experiment notebooks
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
